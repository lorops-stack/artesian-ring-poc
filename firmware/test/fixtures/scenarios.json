{
  "kind": "ring-scenarios",
  "note": "Shared by ui/test/fixtures.test.js (JavaScript state machine) and firmware/test/test_core (C++). Each plan segment holds a hand position for ms (null = no hand); wobble alternates x by 4 mm so the hand is never perfectly still; speed is mm/s. Zone names resolve to the zone centre of the kitchen layout. Expected events are an ordered subsequence; state is the final state (0 IDLE 1 ARMING 2 ACTIVE 3 CUP_FULL 4 EXIT_PENDING 5 CLEAN).",
  "scenarios": [
    { "id": "T5", "title": "settle in Warm latches within 150 ms and reports latency", "plan": [{"ms":135,"zone":"warm","speed":400},{"ms":300,"zone":"warm","wobble":true}], "events": [{"ev":"session","a":"start"},{"ev":"latch","fn":"warm"}], "state": 2, "fn": "warm", "latMax": 400 },
    { "id": "T6", "title": "latch holds while roaming; off 1 s after the last frame seen", "plan": [{"ms":135,"zone":"hot","speed":400},{"ms":300,"zone":"hot","wobble":true},{"ms":500,"zone":"cold","wobble":true},{"ms":500,"zone":"soap","wobble":true},{"ms":1100,"pos":null}], "events": [{"ev":"latch","fn":"hot"},{"ev":"off","why":"exit"},{"ev":"session","a":"end"}], "state": 0, "noEvents": [{"ev":"latch","fn":"cold"},{"ev":"soap"}] },
    { "id": "T7", "title": "hand back within the countdown cancels it", "plan": [{"ms":135,"zone":"cold","speed":400},{"ms":300,"zone":"cold","wobble":true},{"ms":600,"pos":null},{"ms":200,"zone":"cold","wobble":true}], "events": [{"ev":"latch","fn":"cold"},{"ev":"resume"}], "state": 2, "fn": "cold", "noEvents": [{"ev":"off"}] },
    { "id": "T8", "title": "soap doses once per session, then a water zone latches", "plan": [{"ms":135,"zone":"soap","speed":400},{"ms":300,"zone":"soap","wobble":true},{"ms":400,"zone":"soap","wobble":true},{"ms":400,"zone":"warm","wobble":true}], "events": [{"ev":"soap"},{"ev":"latch","fn":"warm"}], "state": 2, "fn": "warm", "count": {"soap": 1} },
    { "id": "T9a", "title": "disposal needs a 1 s hold, stops on a Neutral settle, never restarts in the session", "plan": [{"ms":135,"zone":"disposal","speed":400},{"ms":1200,"zone":"disposal","wobble":true},{"ms":400,"zone":"neutral","wobble":true},{"ms":1500,"zone":"disposal","wobble":true}], "events": [{"ev":"disp","a":"start"},{"ev":"disp","a":"stop","why":"zone"}], "state": 1, "count": {"disp.start": 1} },
    { "id": "T9b", "title": "disposal keeps running after hands leave and stops on its timer", "plan": [{"ms":135,"zone":"disposal","speed":400},{"ms":1200,"zone":"disposal","wobble":true},{"ms":1200,"pos":null},{"ms":15000,"pos":null}], "events": [{"ev":"disp","a":"start"},{"ev":"off","why":"exit"},{"ev":"disp","a":"stop","why":"timer"}], "state": 0 },
    { "id": "T10a", "title": "an object (no movement) never starts a session", "plan": [{"ms":2000,"zone":"warm","speed":0}], "events": [], "state": 0, "noEvents": [{"ev":"session"}] },
    { "id": "T10b", "title": "a target perfectly still for 10 s is an object: water off, session ends", "plan": [{"ms":135,"zone":"cup","speed":400},{"ms":300,"zone":"cup","wobble":true},{"ms":11000,"zone":"cup","speed":0}], "events": [{"ev":"latch","fn":"cup"},{"ev":"still"},{"ev":"off","why":"still"}], "state": 0 },
    { "id": "T11", "title": "cup fill stops at the set volume and stays latched", "plan": [{"ms":135,"zone":"cup","speed":400},{"ms":300,"zone":"cup","wobble":true},{"ms":4500,"zone":"cup","wobble":true}], "events": [{"ev":"latch","fn":"cup"},{"ev":"cupfull"}], "state": 3, "fn": "cup" },
    { "id": "FLAG", "title": "flagged frames never latch; the next usable frames do", "plan": [{"ms":135,"zone":"warm","speed":400},{"ms":400,"zone":"warm","flag":4},{"ms":300,"zone":"warm","wobble":true}], "events": [{"ev":"latch","fn":"warm"}], "state": 2, "fn": "warm" },
    { "id": "CLEAN", "title": "Neutral held 3 s starts clean mode; nothing latches in it", "plan": [{"ms":135,"zone":"neutral","speed":400},{"ms":3200,"zone":"neutral","wobble":true},{"ms":500,"zone":"hot","wobble":true}], "events": [{"ev":"clean","a":"start"}], "state": 5, "noEvents": [{"ev":"latch"}] },
    { "id": "SAVED", "title": "water saved is split into off-when-hands-out and flow rate", "plan": [{"ms":135,"zone":"warm","speed":400},{"ms":2000,"zone":"warm","wobble":true},{"ms":1200,"pos":null}], "events": [{"ev":"session","a":"end","usedMin":100,"savedOffMin":1,"savedFlowMin":1}], "state": 0 }
  ]
}
